# Copy to .env on the VPS and fill in. Never commit .env.

# API
API_PORT=
PUBLIC_BASE_URL=

# Postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Host is the compose service name: postgres://USER:PASSWORD@postgres/DB?sslmode=disable
# PASSWORD must be percent-encoded here; `openssl rand -hex 32` avoids characters that need it.
DATABASE_URL=

# Auth
JWT_SECRET=

# Apple (optional until the Apple Developer account exists; set both or neither).
# Team ID: 10 characters from developer.apple.com > Membership. Used by Universal
# Links (apple-app-site-association), Sign in with Apple and APNs.
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=
# Public TestFlight link shown on the invite landing page (/i/<token>) to people
# without the app. Optional: without it the page says the app is not out yet.
TESTFLIGHT_URL=

# APNs (token auth)
APNS_KEY_ID=
APNS_KEY_PATH=
APNS_ENVIRONMENT=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Backups: R2 keys and the age public key go in a separate file, .env.backup
# (see .env.backup.example). Only the backup service reads it.
