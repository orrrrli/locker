# Copy to .env.backup on the VPS, next to .env, and fill in. Never commit .env.backup.
# Only the backup service reads this file, so the api never receives these keys.

# Cloudflare R2: account ID (R2 overview page) and a token with Object Read & Write,
# limited to the backups bucket (see docs/operations.md, Backups).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# age PUBLIC key (starts with age1). The private key never goes on the VPS.
BACKUP_AGE_RECIPIENT=
